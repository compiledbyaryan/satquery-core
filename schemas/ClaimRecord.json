{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "mask",
            "boxes",
            "metrics",
            "preview",
            "assertions",
            "report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "CalibratedConfidence": {
      "additionalProperties": false,
      "properties": {
        "calibration_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Calibration Id",
          "type": "string"
        },
        "population_scope": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Population Scope",
          "type": "string"
        },
        "probability": {
          "maximum": 1,
          "minimum": 0,
          "title": "Probability",
          "type": "number"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "probability",
        "calibration_id",
        "population_scope"
      ],
      "title": "CalibratedConfidence",
      "type": "object"
    },
    "CheckResult": {
      "additionalProperties": false,
      "properties": {
        "check_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Check Id",
          "type": "string"
        },
        "detail": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Detail",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "status": {
          "enum": [
            "pass",
            "fail",
            "unknown",
            "not_applicable"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "check_id",
        "status",
        "required",
        "detail"
      ],
      "title": "CheckResult",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "$ref": "#/$defs/CheckResult"
      },
      "title": "Checks",
      "type": "array"
    },
    "claim_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Claim Id",
      "type": "string"
    },
    "confidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/CalibratedConfidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Evidence",
      "type": "array"
    },
    "kind": {
      "enum": [
        "observation",
        "measurement",
        "interpretation",
        "hypothesis"
      ],
      "title": "Kind",
      "type": "string"
    },
    "region_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "status": {
      "enum": [
        "supported",
        "partial",
        "unresolved",
        "stale"
      ],
      "title": "Status",
      "type": "string"
    },
    "text": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    }
  },
  "required": [
    "claim_id",
    "run_id",
    "text",
    "kind",
    "status",
    "evidence",
    "checks"
  ],
  "title": "ClaimRecord",
  "type": "object"
}
