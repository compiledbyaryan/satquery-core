{
  "$defs": {
    "AnalysisParams": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "analysis",
          "default": "analysis",
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "task": {
          "enum": [
            "inspect",
            "measure_change",
            "verify_claims"
          ],
          "title": "Task",
          "type": "string"
        },
        "unit": {
          "default": "pixels",
          "enum": [
            "pixels",
            "m2",
            "ha"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "task"
      ],
      "title": "AnalysisParams",
      "type": "object"
    },
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
          "title": "Artifact Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "text",
            "mask",
            "boxes",
            "metrics",
            "preview",
            "assertions",
            "report"
          ],
          "title": "Kind",
          "type": "string"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "sha256",
        "kind"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "FusionParams": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "fusion",
          "default": "fusion",
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Target",
          "type": "string"
        },
        "task": {
          "const": "cross_modal",
          "default": "cross_modal",
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "title": "FusionParams",
      "type": "object"
    },
    "SingleParams": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "single",
          "default": "single",
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "task": {
          "enum": [
            "vqa",
            "caption",
            "grounding"
          ],
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "task"
      ],
      "title": "SingleParams",
      "type": "object"
    },
    "TemporalParams": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "temporal",
          "default": "temporal",
          "title": "Kind",
          "type": "string"
        },
        "question": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        },
        "target": {
          "anyOf": [
            {
              "maxLength": 1000,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target"
        },
        "task": {
          "enum": [
            "change_description",
            "change_vqa"
          ],
          "title": "Task",
          "type": "string"
        }
      },
      "required": [
        "task"
      ],
      "title": "TemporalParams",
      "type": "object"
    },
    "ToolError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "enum": [
            "INVALID_INPUT",
            "UNSUPPORTED",
            "TIMEOUT",
            "OUT_OF_MEMORY",
            "MODEL_UNAVAILABLE",
            "INVALID_OUTPUT",
            "INTERNAL"
          ],
          "title": "Code",
          "type": "string"
        },
        "message": {
          "maxLength": 1000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Message",
          "type": "string"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "schema_version": {
          "const": "0.1",
          "default": "0.1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ToolError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "at": {
      "format": "date-time",
      "title": "At",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ToolError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "event_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Event Id",
      "type": "string"
    },
    "inputs": {
      "default": [],
      "items": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
        "type": "string"
      },
      "title": "Inputs",
      "type": "array"
    },
    "outputs": {
      "default": [],
      "items": {
        "$ref": "#/$defs/ArtifactRef"
      },
      "title": "Outputs",
      "type": "array"
    },
    "params": {
      "discriminator": {
        "mapping": {
          "analysis": "#/$defs/AnalysisParams",
          "fusion": "#/$defs/FusionParams",
          "single": "#/$defs/SingleParams",
          "temporal": "#/$defs/TemporalParams"
        },
        "propertyName": "kind"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SingleParams"
        },
        {
          "$ref": "#/$defs/TemporalParams"
        },
        {
          "$ref": "#/$defs/FusionParams"
        },
        {
          "$ref": "#/$defs/AnalysisParams"
        }
      ],
      "title": "Params"
    },
    "run_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "sequence": {
      "minimum": 1,
      "title": "Sequence",
      "type": "integer"
    },
    "status": {
      "enum": [
        "started",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "step_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Step Id",
      "type": "string"
    },
    "tool_id": {
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$",
      "title": "Tool Id",
      "type": "string"
    },
    "tool_version": {
      "maxLength": 1000,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Tool Version",
      "type": "string"
    }
  },
  "required": [
    "event_id",
    "run_id",
    "step_id",
    "sequence",
    "at",
    "status",
    "tool_id",
    "tool_version",
    "params"
  ],
  "title": "ExecutionEvent",
  "type": "object"
}
